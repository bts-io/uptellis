# Uptellis agent configuration: /etc/uptellis/agent.env (Docker) or /etc/uptellis-agent/agent.env
# (systemd). The API key is NOT here: it is a file (Docker secret or systemd credential), mode 600.
UPTELLIS_URL=https://status.example.org
# The agent id declared in the site's `agents` and listed in its monitors' `runners`.
UPTELLIS_RUNNER=office-1
# Checks running at once (1 to 64).
UPTELLIS_CONCURRENCY=8
# Where results wait until the instance acknowledges them (set by the image and the systemd unit).
#UPTELLIS_DATA_DIR=/var/lib/uptellis-agent
# Only for an instance on a trusted LAN without TLS.
#UPTELLIS_ALLOW_HTTP=1
#LOG_LEVEL=debug

# Copy to docker.env (gitignored) for compose.yaml. Every value may instead be read from a file:
# set NAME_FILE=/run/secrets/<name> in place of NAME. Generate secrets with `openssl rand -hex 32`.

# The site a request renders when its host matches no site's hostnames (sites/<id>.json).
SITE_DEFAULT=demo

# Signs sessions and encrypts the JWT keys; 32 random bytes: openssl rand -base64 32. Empty: no accounts.
BETTER_AUTH_SECRET=
# The public URL of this instance (invite links, JWT issuer, trusted origin), e.g. https://status.example.com
PUBLIC_URL=
# Optional sign-in with GitHub or Google: set both the client id and the secret of a provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seals the ingest keys created in admin; 32 random bytes, base64: openssl rand -base64 32
SOURCE_MASTER_KEY=
# Discord webhook for the stale and recovered cards (and down and up with notify.discord). Empty: no cards.
DISCORD_WEBHOOK_URL=
# Notification channel secrets: each channel in a site's notify.channels names its own, e.g.
# NOTIFY_SLACK_OPS=<the Slack incoming webhook URL> or NOTIFY_NTFY_TOKEN=... (read when sent).
# NOTIFY_TWILIO_TOKEN=<the Twilio auth token> for an SMS channel (docs/monitors.md, SMS setup).

# Email channels: the default sender address, and one sender. Either the Cloudflare Email Service REST API
# (both values), or SMTP: smtps://user:pass@host:465 or smtp://user:pass@host:587 (STARTTLS).
EMAIL_FROM=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SMTP_URL=

# Behind a reverse proxy that sets X-Forwarded-For: 1 makes the rate limits see the client address.
TRUST_PROXY=0

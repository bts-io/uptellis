{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
  },
  // The Docker adapter runs on Bun: tsconfig.docker.json checks it.
  "exclude": ["src/platform/docker"],
  "include": [
    "src/worker",
    "src/shared",
    "src/platform",
    "src/server.ts",
    "src/globals.d.ts",
    "src/secrets.d.ts",
    "worker-configuration.d.ts",
    "tests/integration",
    "tests/ssr"
  ]
}

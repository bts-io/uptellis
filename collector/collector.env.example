# /etc/uptellis/collector.env on watch-1 (not in git once filled in). Secrets are NOT here: they
# are files mounted by compose.yaml (kuma_password, ingest_key, cf_access_client_secret).
KUMA_URL=http://localhost:3001
KUMA_USERNAME=admin
COLLECTOR_HOST=watch-1
INGEST_URL=https://status.example.com/api/ingest/kuma
KEY_ID=collector-1
CF_ACCESS_CLIENT_ID=<status-collector-1 service token client id>
# Tailnet address -> host name, one JSON object on one line.
HOST_ALIASES={"<primary tailnet address>":"app-1","<standby tailnet address>":"app-2","<runner tailnet address>":"runner-1"}
INTERVAL_S=60
BUFFER_WINDOW_MIN=60

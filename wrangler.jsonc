{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uptellis",
  // No account_id: wrangler takes the account from `wrangler login` or CLOUDFLARE_ACCOUNT_ID.
  "main": "./src/server.ts",
  // Must not be newer than the workerd bundled with @cloudflare/vitest-pool-workers, or the Workers-pool tests
  // refuse to start. Move it forward when the pool moves.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Served on workers.dev. To use your own hostname, add a custom domain route, for example
  // "routes": [{ "pattern": "status.example.com", "custom_domain": true }], and list it in the site config.
  "workers_dev": true,
  "preview_urls": false,
  // Invocation logs are off: they record each request's URL, and invite links carry their one-time token in
  // the path. The Worker's own structured console logs (ids, codes, counts) stay on.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "upload_source_maps": true,

  // Client bundle and fonts come from Workers Static Assets; every page is server-rendered and /api/* is Hono.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/favicon.ico"]
  },

  "vars": {
    // The site a bare "/" renders (sites/<id>.json).
    "SITE_DEFAULT": "demo"
  },

  // No database_id: the Deploy to Cloudflare button provisions the database, and wrangler finds it by name.
  // By hand, run `bunx wrangler d1 create uptellis-db` once before the first `bun run deploy` (which applies
  // the migrations first); adding the printed "database_id" here is optional.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptellis-db",
      "migrations_dir": "./migrations"
    }
  ],

  // latest:<site> snapshots and other short-lived reads. No id: `wrangler deploy` (and the Deploy button)
  // provisions the namespace. To create it by hand, run `bunx wrangler kv namespace create uptellis-cache`
  // and add the printed "id" here.
  "kv_namespaces": [{ "binding": "CACHE" }],

  // Email channels (src/worker/notify/providers/email.ts) send through the Cloudflare Email Service. Onboard
  // the sending domain first (Email Service in the dashboard), then uncomment this binding and set the
  // EMAIL_FROM var (or a per-channel "from") to an address on that domain; `DEPLOY_EMAIL_FROM=<address>
  // bun run deploy:config` does both. Without it, email channels fail
  // with "email_unavailable" and every other channel works as before.
  // "send_email": [{ "name": "EMAIL" }],

  // The three scheduled jobs (JOBS in src/platform/types.ts; a unit test checks these match): every 5 min
  // downsample heartbeats and sweep source staleness; daily at 03:17 UTC prune rows past retention; every
  // minute run the probes of public URLs.
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *", "* * * * *"] },

  // Rate limits (src/worker/middleware/rate-limit.ts). Counted per Cloudflare location, so they are
  // approximate: a brake on floods and key guessing, not a quota. Ingest is per key id and client IP (the
  // collector posts every 60 s, the facts pusher every 15 min); the gate counts sign-in attempts and
  // refused requests (401, 403, 404) per client IP; admin writes are per client IP; push monitor calls
  // (`/api/push/<token>`) are one per 10 s per token (keyed by the token's hash, never the token).
  "ratelimits": [
    { "name": "INGEST_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "GATE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "ADMIN_WRITE_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUSH_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 1, "period": 10 } }
  ]
}
